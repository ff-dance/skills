_base_: ../_base_/default.yaml

model:
  reasoning_effort: medium

train:
  batch_size: 4
  accumulation: 1
  num_epochs: 3

gradient:
  minibatch_size: 4
  merge_batch_size: 4
  analyst_workers: 4

optimizer:
  learning_rate: 4
  use_slow_update: true
  use_meta_skill: true

evaluation:
  sel_env_num: 0
  test_env_num: 0
  eval_test: true

env:
  name: siemens_slides_spec
  skill_init: skillopt/envs/siemens_slides_spec/skills/initial.md
  split_mode: split_dir
  split_dir: __REPO_ROOT__/evals/skillopt
  siemens_repo_root: __REPO_ROOT__
  linter_path: __REPO_ROOT__/scripts/skillopt_spec_lint.py
  workers: 4
  max_completion_tokens: 8192
  judge_max_completion_tokens: 4096
  use_llm_judge: true
  limit: 0
